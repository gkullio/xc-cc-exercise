<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Capsule Corp</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= basePath %>/css/style.css">
  <% if (internal) { %>
  <link rel="stylesheet" href="<%= basePath %>/css/internal-banner.css">
  <% } %>
</head>
<body>
<% if (internal) { %>
<div class="internal-banner">
  <span>&#9888;</span>
  <span>INTERNAL ACCESS ONLY</span>
</div>
<% } %>
  <header class="header">
    <div class="container">
      <a href="<%= basePath %>/" class="logo">
        <img src="<%= basePath %>/images/cc-logo.png" alt="Capsule Corp" class="logo-img">
        <span class="logo-text">CAPSULE CORP</span>
      </a>
      <nav class="nav">
        <a href="<%= basePath %>/products">All Capsules</a>
        <a href="<%= basePath %>/cart" class="cart-link">
          Cart <span class="cart-badge"><%= cartCount %></span>
        </a>
        <% if (user) { %>
          <a href="<%= basePath %>/account"><%= user.name %></a>
          <a href="<%= basePath %>/logout">Logout</a>
        <% } else { %>
          <a href="<%= basePath %>/login">Login</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="main">
    <div class="container">
      <%- body %>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; Capsule Corporation - West City</p>
      <p class="footer-tagline">Hoi-Poi Capsules: The Future in Your Pocket</p>
    </div>
  </footer>

  <script>window.APP_BASE_PATH = '<%= basePath %>';</script>
  <script src="<%= basePath %>/js/main.js"></script>
</body>
</html>
