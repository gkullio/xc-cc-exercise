<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Capsule Corp</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <div class="container">
      <a href="/" class="logo">
        <span class="logo-icon">⬡</span>
        <span class="logo-text">CAPSULE CORP</span>
      </a>
      <nav class="nav">
        <a href="/products">All Capsules</a>
        <a href="/cart" class="cart-link">
          Cart <span class="cart-badge"><%= cartCount %></span>
        </a>
        <% if (user) { %>
          <a href="/account"><%= user.name %></a>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="main">
    <div class="container">
      <%- body %>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; Capsule Corporation - West City</p>
      <p class="footer-tagline">Hoi-Poi Capsules: The Future in Your Pocket</p>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
