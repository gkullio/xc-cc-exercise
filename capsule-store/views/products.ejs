<h1>All Capsules</h1>

<div class="product-grid">
  <% products.forEach(product => { %>
    <div class="product-card <%= !product.inStock ? 'out-of-stock' : '' %>">
      <div class="product-image">
        <img src="<%= basePath %><%= product.image %>" alt="<%= product.name %>" class="capsule-img">
        <span class="capsule-number">#<%= product.capsuleNumber %></span>
        <% if (!product.inStock) { %>
          <span class="stock-badge">Out of Stock</span>
        <% } %>
      </div>
      <h3><%= product.name %></h3>
      <p class="category"><%= product.category %></p>
      <p class="price"><%= formatPrice(product.price) %></p>
      <a href="<%= basePath %>/products/<%= product.id %>" class="btn">View Details</a>
    </div>
  <% }) %>
</div>
